# ==============================================================================
# DentalCore Commercial Master - Environment Configuration Template
# ==============================================================================

# API Base URL:
# - Leave blank for local development (Vite dev server proxies to http://localhost:3001)
# - Set full domain when hosted on separate API domain (e.g. https://api.clientclinic.com)
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 1. COMMERCIAL PRODUCT EDITION (standard | premium | custom)
# ------------------------------------------------------------------------------
# - 'standard': Standard Edition (Core reception, patients, queue, doctor workspace, billing)
#               Disables: OPG/RVG, Reimbursement, Transfer Patient, External Advice, Audit.
# - 'premium' : Premium Edition (Unlocks full clinical suite: OPG/RVG, Reimbursement, etc.)
# - 'custom'  : Custom per-clinic deployment
VITE_APP_TIER=standard

# ------------------------------------------------------------------------------
# 2. MODULAR FEATURE OVERRIDES (true | false)
# Leave commented out to inherit tier defaults, or uncomment to override for specific clients:
# ------------------------------------------------------------------------------
# VITE_FEATURE_OPG_RVG=false              # Digital Radiography (OPG / RVG)
# VITE_FEATURE_REIMBURSEMENT=false        # Insurance & Reimbursement claims
# VITE_FEATURE_TRANSFER_PATIENT=false     # Patient queue transfer between doctors
# VITE_FEATURE_EXTERNAL_ADVICE=false      # External specialist medical advice
# VITE_FEATURE_PHARMACY=true              # In-house medicine dispensing (set to false if clinic has no pharmacy)
# VITE_FEATURE_SEPARATE_MATERIAL_PO=false # Separate Material / Lab PO menu & report
# VITE_FEATURE_AUDIT_FIELD=false          # Isolated Receipt Audit field (strictly false unless requested)
# VITE_FEATURE_HISTORICAL_MIGRATION=false # Historical paper records migration

# ------------------------------------------------------------------------------
# 3. WHITE-LABEL CLINIC IDENTITY & BRANDING
# ------------------------------------------------------------------------------
VITE_CLINIC_NAME="Dental Care Clinic"
VITE_CLINIC_TAGLINE="Advanced Oral Health & Dental Care"
VITE_CLINIC_PHONE="+91 98765 43210"
VITE_CLINIC_EMAIL="care@dentalclinic.com"
VITE_CLINIC_ADDRESS="123 Healthcare Ave, Medical Enclave"
VITE_CLINIC_LOGO_URL="/scripters_zone_logo_zoomed.png"
VITE_CLINIC_ICON_URL="/dental-icon.png"
